# Supabase Configuration
# Get these values from: https://supabase.com/dashboard → Settings → API

# Supabase Project URL
VITE_SUPABASE_URL=https://xxxxx.supabase.co

# Supabase Anonymous Key (public)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Development Environment
NODE_ENV=development

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values with your actual Supabase credentials
# 3. DO NOT commit the .env file to Git (it's in .gitignore)
#
# For setup help, run:
#   node scripts/setup-supabase.js --setup
#
# Or read the complete guide:
#   GUIA_CONFIGURACION_SUPABASE.md
